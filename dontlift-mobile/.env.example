# Register a Web App in your Firebase project and copy its client config.
EXPO_PUBLIC_FIREBASE_RUNTIME_MODE=cloud
EXPO_PUBLIC_FIREBASE_PROJECT_ID=august-monument-508716-u0
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Release builds require an explicit, separate production project and its Web config.
EXPO_PUBLIC_FIREBASE_PRODUCTION_PROJECT_ID=

# Public HTTPS origin of external Express Premium API. No payOS/Admin keys in app.
EXPO_PUBLIC_PREMIUM_API_URL=
