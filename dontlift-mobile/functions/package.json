{
  "name": "dontlift-firebase-tests",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:rules": "node --test tests/profile-owner-read.rules.emulator.test.cjs",
    "test:login": "node --test tests/login-profile-read.rules.emulator.test.cjs",
    "test:registration": "node --test tests/registration-profile.test.cjs",
    "test:rooms": "node --test tests/room-create.rules.emulator.test.cjs tests/room-join-pin.rules.emulator.test.cjs tests/room-lobby-start.rules.emulator.test.cjs tests/group-active-rules.emulator.test.cjs",
    "test:sync:unit": "node --test tests/solo-sync-handler.test.cjs",
    "test:sync": "node --test tests/solo-sync.test.cjs",
    "test:history": "node --test tests/solo-history-rules.emulator.test.cjs",
    "test:emulators": "firebase emulators:exec --config ../firebase.emulator.json --project demo-dontlift-expo-go --only auth,firestore,functions \"pnpm run test:rules && pnpm run test:login && pnpm run test:registration && pnpm run test:rooms && pnpm run test:sync:unit && pnpm run test:sync && pnpm run test:history\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
