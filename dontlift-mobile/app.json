{
  "expo": {
    "name": "dontlift-mobile",
    "slug": "dontlift-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dontliftmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dontlift.mobile"
    },
    "android": {
      "package": "com.dontlift.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "DontLift cần quyền camera để quét mã mời vào phòng.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "backgroundColor": "#208AEF",
            "drawable": {
              "icon": "./assets/splashscreen.xml"
            }
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "DontLift uses motion data to check your accelerometer before starting a focus session."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
