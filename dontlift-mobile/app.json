{
  "expo": {
    "name": "dontlift-mobile",
    "slug": "dontlift-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dontliftmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dontlift.mobile",
      "googleServicesFile": "./firebase-config/GoogleService-Info.plist"
    },
    "android": {
      "package": "com.dontlift.mobile",
      "googleServicesFile": "./firebase-config/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "backgroundColor": "#208AEF",
            "drawable": {
              "icon": "./assets/splashscreen.xml"
            }
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
