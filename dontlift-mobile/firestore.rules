rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function hostMemberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function earlyExitRequestPath(roomId, memberUid) {
      return /databases/$(database)/documents/rooms/$(roomId)/earlyExitRequests/$(memberUid);
    }

    function terminationVotePath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId)/terminationVotes/current;
    }

    function terminationBallotPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/terminationVotes/current/ballots/$(uid);
    }

    function reconciliationAuditPath(roomId, auditId) {
      return /databases/$(database)/documents/rooms/$(roomId)/reconciliationAudits/$(auditId);
    }

    function settlementDetailsPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId)/settlementDetails/current;
    }

    function billCommandPath(roomId, requestId) {
      return /databases/$(database)/documents/rooms/$(roomId)/billCommands/$(requestId);
    }

    function validBillPublishRoom(roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let receiptPath = billCommandPath(roomId, after.get('billRequestId', '_missing_'));
      let hostPath = hostMemberPath(roomId, request.auth.uid);
      return signedIn()
        && before.status == 'COMPLETED'
        && before.reconciliationStatus == 'FINALIZED'
        && before.hostId == request.auth.uid
        && exists(hostPath)
        && get(hostPath).data.role == 'HOST'
        && get(hostPath).data.status == 'ACTIVE'
        && exists(settlementDetailsPath(roomId))
        && get(settlementDetailsPath(roomId)).data.expiresAt is timestamp
        && get(settlementDetailsPath(roomId)).data.expiresAt > request.time
        && before.get('calculationVersion', null) == null
        && before.get('billRequestId', null) == null
        && after.diff(before).affectedKeys().hasOnly([
          'totalBillVnd', 'calculationVersion', 'billRequestId', 'billPublishedAt', 'billShareCount'
        ])
        && after.totalBillVnd is int && after.totalBillVnd >= 1000
        && after.calculationVersion == 1
        && after.billRequestId is string
        && after.billRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && after.billPublishedAt == request.time
        && after.billShareCount is int && after.billShareCount > 0
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.hostUid == request.auth.uid
        && getAfter(receiptPath).data.requestId == after.billRequestId
        && getAfter(receiptPath).data.totalBillVnd == after.totalBillVnd
        && getAfter(receiptPath).data.shareCount == after.billShareCount
        && getAfter(receiptPath).data.shareUids is list
        && getAfter(receiptPath).data.shareUids.size() == after.billShareCount
        && getAfter(receiptPath).data.sumShareVnd == after.totalBillVnd;
    }

    function validBillCommandCreate(roomId, requestId) {
      let data = request.resource.data;
      let roomAfterPath = roomPath(roomId);
      let hostPath = hostMemberPath(roomId, request.auth.uid);
      return signedIn()
        && requestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && data.keys().hasAll([
          'version', 'requestId', 'roomId', 'hostUid', 'totalBillVnd',
          'calculationVersion', 'shareCount', 'shareUids', 'sumShareVnd', 'createdAt'
        ])
        && data.keys().hasOnly([
          'version', 'requestId', 'roomId', 'hostUid', 'totalBillVnd',
          'calculationVersion', 'shareCount', 'shareUids', 'sumShareVnd', 'createdAt'
        ])
        && data.version == 1
        && data.requestId == requestId
        && data.roomId == roomId
        && data.hostUid == request.auth.uid
        && data.totalBillVnd is int && data.totalBillVnd >= 1000
        && data.calculationVersion == 1
        && data.shareCount is int && data.shareCount > 0
        && data.shareUids is list && data.shareUids.size() == data.shareCount
        && data.sumShareVnd == data.totalBillVnd
        && data.createdAt == request.time
        && exists(hostPath)
        && get(hostPath).data.role == 'HOST'
        && get(hostPath).data.status == 'ACTIVE'
        && existsAfter(roomAfterPath)
        && getAfter(roomAfterPath).data.status == 'COMPLETED'
        && getAfter(roomAfterPath).data.reconciliationStatus == 'FINALIZED'
        && getAfter(roomAfterPath).data.hostId == request.auth.uid
        && getAfter(roomAfterPath).data.calculationVersion == 1
        && getAfter(roomAfterPath).data.billRequestId == requestId
        && getAfter(roomAfterPath).data.totalBillVnd == data.totalBillVnd
        && getAfter(roomAfterPath).data.billShareCount == data.shareCount;
    }

    function validBillShareCreate(roomId, uid) {
      let data = request.resource.data;
      let roomAfterPath = roomPath(roomId);
      let hostPath = hostMemberPath(roomId, request.auth.uid);
      let shareMemberPath = hostMemberPath(roomId, uid);
      let receiptPath = billCommandPath(roomId, data.get('requestId', '_missing_'));
      return signedIn()
        && uid == data.uid
        && data.keys().hasAll(['uid', 'shareVnd', 'requestId', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'shareVnd', 'requestId', 'updatedAt'])
        && data.shareVnd is int && data.shareVnd >= 0
        && data.requestId is string
        && data.updatedAt == request.time
        && exists(hostPath)
        && get(hostPath).data.role == 'HOST'
        && get(hostPath).data.status == 'ACTIVE'
        && exists(shareMemberPath)
        && get(shareMemberPath).data.status in ['ACTIVE', 'EARLY_EXIT']
        && existsAfter(roomAfterPath)
        && getAfter(roomAfterPath).data.status == 'COMPLETED'
        && getAfter(roomAfterPath).data.reconciliationStatus == 'FINALIZED'
        && getAfter(roomAfterPath).data.hostId == request.auth.uid
        && getAfter(roomAfterPath).data.billRequestId == data.requestId
        && existsAfter(receiptPath)
        && getAfter(receiptPath).data.hostUid == request.auth.uid
        && uid in getAfter(receiptPath).data.shareUids
        && getAfter(receiptPath).data.totalBillVnd == getAfter(roomAfterPath).data.totalBillVnd
        && exists(settlementDetailsPath(roomId))
        && get(settlementDetailsPath(roomId)).data.expiresAt > request.time;
    }

    function validSettlementDetails(roomId) {
      let room = get(roomPath(roomId)).data;
      let hostPath = hostMemberPath(roomId, request.auth.uid);
      let data = request.resource.data;
      return signedIn()
        && room.status == 'COMPLETED'
        && room.reconciliationStatus == 'FINALIZED'
        && room.endedAt is timestamp
        && room.hostId == request.auth.uid
        && exists(hostPath)
        && get(hostPath).data.role == 'HOST'
        && get(hostPath).data.status == 'ACTIVE'
        && data.keys().hasAll(['bankId', 'accountNumber', 'accountName', 'updatedAt', 'expiresAt'])
        && data.keys().hasOnly(['bankId', 'accountNumber', 'accountName', 'updatedAt', 'expiresAt'])
        && data.bankId is string && data.bankId.size() >= 1 && data.bankId.size() <= 32
        && data.bankId.matches('.*[^\\s].*')
        && data.accountNumber is string && data.accountNumber.size() >= 1 && data.accountNumber.size() <= 64
        && data.accountNumber.matches('.*[^\\s].*')
        && data.accountName is string && data.accountName.size() >= 1 && data.accountName.size() <= 100
        && data.accountName.matches('.*[^\\s].*')
        && data.updatedAt == request.time
        && data.expiresAt == room.endedAt + duration.value(30, 'd')
        && request.time < data.expiresAt;
    }

    function pinPath(pin) {
      return /databases/$(database)/documents/roomPins/$(pin);
    }

    function usagePath(uid) {
      return /databases/$(database)/documents/users/$(uid)/usage/current;
    }

    function receiptPath(uid, requestId) {
      return /databases/$(database)/documents/users/$(uid)/commandReceipts/$(requestId);
    }

    // Rules dùng giờ server và lịch UTC+07:00 đã được human duyệt cho D12.
    function currentQuotaBucketStart() {
      let localNow = request.time + duration.value(7, 'h');
      return timestamp.date(localNow.year(), localNow.month(), 1) - duration.value(7, 'h');
    }

    function isServerPremium(uid) {
      return get(profilePath(uid)).data.isPremium == true;
    }

    function hasRoomCreateLinks(roomId, uid, pin, requestId) {
      let room = getAfter(roomPath(roomId)).data;
      let member = getAfter(hostMemberPath(roomId, uid)).data;
      let reservation = getAfter(pinPath(pin)).data;
      let usage = getAfter(usagePath(uid)).data;
      let receipt = getAfter(receiptPath(uid, requestId)).data;
      return room.hostId == uid
        && room.pin == pin
        && room.status == 'WAITING'
        && room.createdAt == request.time
        && member.role == 'HOST'
        && member.displayName == get(profilePath(uid)).data.displayName
        && member.joinedAt == request.time
        && reservation.roomId == roomId
        && reservation.hostId == uid
        && reservation.createdAt == request.time
        && usage.bucketStart == currentQuotaBucketStart()
        && usage.lastRequestId == requestId
        && usage.updatedAt == request.time
        && receipt.roomId == roomId
        && receipt.pin == pin
        && receipt.hostId == uid
        && receipt.status == 'WAITING'
        && receipt.createdAt == request.time;
    }

    function hasRoomJoinLinks(roomId, uid, pin, requestId) {
      let room = getAfter(roomPath(roomId)).data;
      let member = getAfter(hostMemberPath(roomId, uid)).data;
      let receipt = getAfter(receiptPath(uid, requestId)).data;
      return !exists(hostMemberPath(roomId, uid))
        && room.pin == pin
        && room.status == 'WAITING'
        && room.updatedAt == request.time
        && room.lastJoinRequestId == requestId
        && room.participantCount == get(roomPath(roomId)).data.participantCount + 1
        && (get(roomPath(roomId)).data.participantCount < 5 || isServerPremium(room.hostId))
        && member.role == 'MEMBER'
        && member.status == 'ACTIVE'
        && member.displayName == get(profilePath(uid)).data.displayName
        && member.joinedAt == request.time
        && member.penaltyScore == 0
        && member.liftCount == 0
        && member.violationDurationSeconds == 0
        && receipt.requestId == requestId
        && receipt.roomId == roomId
        && receipt.pin == pin
        && receipt.hostId == room.hostId
        && receipt.status == 'WAITING'
        && receipt.createdAt == request.time;
    }

    function validJoinReceipt(uid, data, requestId) {
      return data.keys().hasAll(['version', 'requestId', 'roomId', 'pin', 'hostId', 'status', 'createdAt'])
        && data.keys().hasOnly(['version', 'requestId', 'roomId', 'pin', 'hostId', 'status', 'createdAt'])
        && data.version == 1
        && data.requestId == requestId
        && data.roomId is string
        && data.pin is string
        && data.pin.matches('^(?:[0-9]{4}|[0-9]{8})$')
        && data.hostId is string
        && data.status == 'WAITING'
        && data.createdAt == request.time
        && get(pinPath(data.pin)).data.roomId == data.roomId
        && hasRoomJoinLinks(data.roomId, uid, data.pin, requestId);
    }

    function canReadRoom(roomId) {
      return signedIn() && (
        exists(hostMemberPath(roomId, request.auth.uid))
        || (exists(pinPath(resource.data.pin)) && get(pinPath(resource.data.pin)).data.roomId == roomId)
      );
    }

    function activeRoomMember(roomId, uid) {
      return exists(roomPath(roomId))
        && get(roomPath(roomId)).data.status == 'ACTIVE'
        && exists(hostMemberPath(roomId, uid))
        && get(hostMemberPath(roomId, uid)).data.status == 'ACTIVE';
    }

    function activeRoomParticipant(roomId, uid) {
      return exists(roomPath(roomId))
        && get(roomPath(roomId)).data.status == 'ACTIVE'
        && exists(hostMemberPath(roomId, uid))
        && get(hostMemberPath(roomId, uid)).data.status in ['ACTIVE', 'EARLY_EXIT'];
    }

    function roomLivenessAt(roomData) {
      let heartbeatAt = roomData.get('hostHeartbeatAt', null);
      let startedAt = roomData.get('startedAt', null);
      return heartbeatAt is timestamp && startedAt is timestamp
        ? (heartbeatAt > startedAt ? heartbeatAt : startedAt)
        : (heartbeatAt is timestamp ? heartbeatAt : startedAt);
    }

    function validHostHeartbeat(roomId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostHeartbeatAt', 'updatedAt'])
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'ACTIVE'
        && resource.data.hostId == request.auth.uid
        && exists(hostMemberPath(roomId, request.auth.uid))
        && get(hostMemberPath(roomId, request.auth.uid)).data.role == 'HOST'
        && get(hostMemberPath(roomId, request.auth.uid)).data.status == 'ACTIVE'
        && request.resource.data.hostHeartbeatAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validStaleRoomAbort(roomId) {
      let livenessAt = roomLivenessAt(resource.data);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt'])
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'ABORTED'
        && resource.data.get('endedAt', null) == null
        && resource.data.startedAt is timestamp
        && livenessAt is timestamp
        && request.time > livenessAt + duration.value(15, 'm')
        && request.resource.data.endedAt == livenessAt + duration.value(15, 'm')
        && request.resource.data.updatedAt == request.time
        && activeRoomParticipant(roomId, request.auth.uid);
    }

    function roomParticipant(roomId, uid) {
      return exists(roomPath(roomId))
        // Giữ roster đọc được cho member đang hoạt động để client dọn session sau khi room kết thúc.
        && get(roomPath(roomId)).data.status in ['WAITING', 'ACTIVE', 'COMPLETED', 'CANCELLED', 'ABORTED']
        && exists(hostMemberPath(roomId, uid))
        && get(hostMemberPath(roomId, uid)).data.status in ['ACTIVE', 'EARLY_EXIT'];
    }

    function canReadGroupViolations(roomId, uid) {
      return roomParticipant(roomId, uid)
        && get(roomPath(roomId)).data.status in ['ACTIVE', 'COMPLETED'];
    }

    function terminalRoomHost(roomId, uid) {
      return signedIn()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.status in ['COMPLETED', 'CANCELLED', 'ABORTED']
        && get(roomPath(roomId)).data.hostId == uid
        && exists(hostMemberPath(roomId, uid))
        && get(hostMemberPath(roomId, uid)).data.role == 'HOST';
    }

    function canRecordGroupViolation(roomId, memberUid, endedAt) {
      let room = get(roomPath(roomId)).data;
      let member = get(hostMemberPath(roomId, memberUid)).data;
      let withinRoom = room.status == 'ACTIVE'
        || (room.status == 'COMPLETED'
          && room.get('reconciliationStatus', null) == 'PENDING'
          && member.get('syncAcknowledgedAt', null) == null
          && room.endedAt is timestamp
          && endedAt <= room.endedAt);
      return withinRoom
        && (member.status == 'ACTIVE'
          || (member.status == 'EARLY_EXIT' && member.earlyExitAt is timestamp && endedAt <= member.earlyExitAt));
    }

    // Chỉ Host đang ACTIVE được chốt room; pending count lấy từ roster đã khóa sau start.
    function validRoomCompletion(roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let hostPath = hostMemberPath(roomId, request.auth.uid);
      let host = get(hostPath).data;
      return signedIn()
        && before.status == 'ACTIVE'
        && before.hostId == request.auth.uid
        && host.role == 'HOST'
        && host.status == 'ACTIVE'
        && before.participantCount is int
        && before.participantCount > 0
        && before.startedAt is timestamp
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'endedAt', 'updatedAt', 'reconciliationStatus', 'pendingMemberCount',
          'completionRequestId', 'lastSyncAckMemberUid', 'lastSyncAckRequestId',
          'finalizedAt', 'finalizedBy', 'finalizationReason'
        ])
        && after.status == 'COMPLETED'
        && after.endedAt == request.time
        && after.updatedAt == request.time
        && after.reconciliationStatus == 'PENDING'
        && after.pendingMemberCount == before.participantCount
        && after.completionRequestId is string
        && after.completionRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && after.lastSyncAckMemberUid == null
        && after.lastSyncAckRequestId == null
        && after.finalizedAt == null
        && after.finalizedBy == null
        && after.finalizationReason == null;
    }

    // ACK của chính member phải đổi cùng counter; Rules chặn ACK lặp giảm count lần nữa.
    function validRoomSyncAcknowledgment(roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let memberBefore = get(hostMemberPath(roomId, request.auth.uid)).data;
      let memberAfter = getAfter(hostMemberPath(roomId, request.auth.uid)).data;
      let finalAck = before.pendingMemberCount == 1;
      return signedIn()
        && before.status == 'COMPLETED'
        && before.reconciliationStatus == 'PENDING'
        && before.endedAt is timestamp
        && before.pendingMemberCount is int
        && before.pendingMemberCount > 0
        && memberBefore.get('syncAcknowledgedAt', null) == null
        && memberAfter.syncedThroughAt == before.endedAt
        && memberAfter.syncAcknowledgedAt == request.time
        && memberAfter.syncAckRequestId is string
        && memberAfter.syncAckRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && after.diff(before).affectedKeys().hasOnly([
          'pendingMemberCount', 'lastSyncAckMemberUid', 'lastSyncAckRequestId',
          'reconciliationStatus', 'finalizationReason', 'finalizedAt', 'finalizedBy'
        ])
        && after.pendingMemberCount == before.pendingMemberCount - 1
        && after.lastSyncAckMemberUid == request.auth.uid
        && after.lastSyncAckRequestId == memberAfter.syncAckRequestId
        && (finalAck
          ? (after.reconciliationStatus == 'FINALIZED'
            && after.finalizationReason == 'ALL_SYNCED'
            && after.finalizedAt == request.time
            && after.finalizedBy == request.auth.uid)
          : (after.reconciliationStatus == 'PENDING'
            && after.get('finalizationReason', null) == before.get('finalizationReason', null)
            && after.get('finalizedAt', null) == before.get('finalizedAt', null)
            && after.get('finalizedBy', null) == before.get('finalizedBy', null)));
    }

    function validHostOverrideAuditLink(roomId, auditId) {
      let before = resource.data;
      let audit = getAfter(reconciliationAuditPath(roomId, auditId)).data;
      return audit.requestId == auditId
        && audit.hostUid == request.auth.uid
        && audit.reason == 'HOST_OVERRIDE'
        && audit.roomEndedAt == before.endedAt
        && audit.createdAt == request.time
        && audit.pendingMemberCount == before.pendingMemberCount
        && audit.scoreSnapshotRef == 'rooms/' + roomId + '/members';
    }

    // Host kết thúc chờ ACK bằng giao dịch Spark; audit phải được tạo cùng lần đổi trạng thái.
    function validHostScoreOverride(roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let host = get(hostMemberPath(roomId, request.auth.uid)).data;
      let auditId = after.get('hostOverrideRequestId', null);
      return signedIn()
        && before.status == 'COMPLETED'
        && before.reconciliationStatus == 'PENDING'
        && before.pendingMemberCount is int
        && before.pendingMemberCount > 0
        && before.hostId == request.auth.uid
        && host.role == 'HOST'
        && host.status == 'ACTIVE'
        && before.endedAt is timestamp
        && auditId is string
        && auditId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && after.diff(before).affectedKeys().hasOnly([
          'reconciliationStatus', 'finalizationReason', 'finalizedAt', 'finalizedBy', 'hostOverrideRequestId'
        ])
        && after.status == before.status
        && after.endedAt == before.endedAt
        && after.pendingMemberCount == before.pendingMemberCount
        && after.reconciliationStatus == 'FINALIZED'
        && after.finalizationReason == 'HOST_OVERRIDE'
        && after.finalizedAt == request.time
        && after.finalizedBy == request.auth.uid
        && validHostOverrideAuditLink(roomId, auditId);
    }

    function validHostOverrideAuditCreate(roomId, auditId) {
      let room = get(roomPath(roomId)).data;
      let roomAfter = getAfter(roomPath(roomId)).data;
      let host = get(hostMemberPath(roomId, request.auth.uid)).data;
      let data = request.resource.data;
      return signedIn()
        && auditId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && room.status == 'COMPLETED'
        && room.reconciliationStatus == 'PENDING'
        && room.pendingMemberCount is int
        && room.pendingMemberCount > 0
        && room.endedAt is timestamp
        && room.hostId == request.auth.uid
        && host.role == 'HOST'
        && host.status == 'ACTIVE'
        && data.keys().hasAll([
          'version', 'requestId', 'hostUid', 'reason', 'confirmedWarning', 'roomEndedAt', 'createdAt',
          'pendingMemberCount', 'unsyncedMemberUids', 'scoreSnapshotRef'
        ])
        && data.keys().hasOnly([
          'version', 'requestId', 'hostUid', 'reason', 'confirmedWarning', 'roomEndedAt', 'createdAt',
          'pendingMemberCount', 'unsyncedMemberUids', 'scoreSnapshotRef'
        ])
        && data.version == 1
        && data.requestId == auditId
        && data.hostUid == request.auth.uid
        && data.reason == 'HOST_OVERRIDE'
        && data.confirmedWarning == true
        && data.roomEndedAt == room.endedAt
        && data.createdAt == request.time
        && data.pendingMemberCount == room.pendingMemberCount
        && data.unsyncedMemberUids is list
        && data.unsyncedMemberUids.size() == room.pendingMemberCount
        && data.scoreSnapshotRef == 'rooms/' + roomId + '/members'
        && roomAfter.reconciliationStatus == 'FINALIZED'
        && roomAfter.finalizationReason == 'HOST_OVERRIDE'
        && roomAfter.finalizedAt == request.time
        && roomAfter.finalizedBy == request.auth.uid
        && roomAfter.hostOverrideRequestId == auditId;
    }

    function validMemberSyncAcknowledgment(roomId, memberUid) {
      let room = get(roomPath(roomId)).data;
      let roomAfter = getAfter(roomPath(roomId)).data;
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && memberUid == request.auth.uid
        && room.status == 'COMPLETED'
        && room.reconciliationStatus == 'PENDING'
        && room.endedAt is timestamp
        && before.status in ['ACTIVE', 'EARLY_EXIT']
        && before.get('syncAcknowledgedAt', null) == null
        && after.diff(before).affectedKeys().hasOnly(['syncedThroughAt', 'syncAcknowledgedAt', 'syncAckRequestId'])
        && after.syncedThroughAt == room.endedAt
        && after.syncAcknowledgedAt == request.time
        && after.syncAckRequestId is string
        && after.syncAckRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && roomAfter.lastSyncAckMemberUid == memberUid
        && roomAfter.lastSyncAckRequestId == after.syncAckRequestId
        && roomAfter.pendingMemberCount == room.pendingMemberCount - 1;
    }

    function validEarlyExitRequest(roomId, memberUid, data, isUpdate) {
      let member = get(hostMemberPath(roomId, memberUid)).data;
      let room = get(roomPath(roomId)).data;
      return signedIn()
        && memberUid == request.auth.uid
        && member.role == 'MEMBER'
        && member.status == 'ACTIVE'
        && member.earlyExitAt == null
        && room.status == 'ACTIVE'
        && data.keys().hasAll(['version', 'requestId', 'memberUid', 'status', 'requestedAt', 'decision', 'decidedBy', 'decidedAt', 'cutoffAt'])
        && data.keys().hasOnly(['version', 'requestId', 'memberUid', 'status', 'requestedAt', 'decision', 'decidedBy', 'decidedAt', 'cutoffAt'])
        && data.version == 1
        && data.requestId is string
        && data.requestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && data.memberUid == memberUid
        && data.status == 'OPEN'
        && data.requestedAt == request.time
        && data.decision == null
        && data.decidedBy == null
        && data.decidedAt == null
        && data.cutoffAt == null
        && (!isUpdate || (resource.data.status == 'DENIED' && data.requestId != resource.data.requestId));
    }

    function validEarlyExitDecision(roomId, memberUid) {
      let room = get(roomPath(roomId)).data;
      let host = get(hostMemberPath(roomId, request.auth.uid)).data;
      let before = resource.data;
      let after = request.resource.data;
      let memberPath = hostMemberPath(roomId, memberUid);
      let memberBefore = get(memberPath).data;
      let memberAfter = getAfter(memberPath).data;
      let approved = after.decision == 'APPROVE';
      return signedIn()
        && room.status == 'ACTIVE'
        && room.hostId == request.auth.uid
        && host.role == 'HOST'
        && host.status == 'ACTIVE'
        && memberBefore.status == 'ACTIVE'
        && memberBefore.role == 'MEMBER'
        && memberBefore.earlyExitAt == null
        && before.status == 'OPEN'
        && before.memberUid == memberUid
        && before.requestId is string
        && after.diff(before).affectedKeys().hasOnly(['status', 'decision', 'decidedBy', 'decidedAt', 'cutoffAt'])
        && after.requestId == before.requestId
        && after.memberUid == memberUid
        && after.status == (approved ? 'APPROVED' : 'DENIED')
        && after.decision in ['APPROVE', 'DENY']
        && after.decidedBy == request.auth.uid
        && after.decidedAt == request.time
        && after.cutoffAt == (approved ? request.time : null)
        && (!approved || (memberAfter.status == 'EARLY_EXIT'
          && memberAfter.earlyExitAt == request.time
          && memberAfter.diff(memberBefore).affectedKeys().hasOnly(['status', 'earlyExitAt'])
          && (room.get('activeMemberCount', null) == null
            ? getAfter(roomPath(roomId)).data.get('activeMemberCount', null) == null
            : (room.activeMemberCount > 1
              && getAfter(roomPath(roomId)).data.activeMemberCount == room.activeMemberCount - 1
              && getAfter(roomPath(roomId)).data.lastEarlyExitMemberUid == memberUid
              && getAfter(roomPath(roomId)).data.lastEarlyExitRequestId == before.requestId))));
    }

    function validOpenTerminationVote(roomId, isUpdate) {
      let data = request.resource.data;
      let room = get(roomPath(roomId)).data;
      let member = get(hostMemberPath(roomId, request.auth.uid)).data;
      return signedIn()
        && room.status == 'ACTIVE'
        && member.status == 'ACTIVE'
        && data.keys().hasAll(['version', 'voteId', 'requestId', 'openedByUid', 'openedAt', 'eligibleVoterCount', 'yesVoteCount', 'status'])
        && data.keys().hasOnly(['version', 'voteId', 'requestId', 'openedByUid', 'openedAt', 'eligibleVoterCount', 'yesVoteCount', 'status', 'closedAt'])
        && data.version == 1
        && data.voteId is string
        && data.voteId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && data.requestId == data.voteId
        && data.openedByUid == request.auth.uid
        && data.openedAt == request.time
        && data.eligibleVoterCount == room.activeMemberCount
        && data.eligibleVoterCount is int && data.eligibleVoterCount > 0
        && data.yesVoteCount == 0
        && data.status == 'OPEN'
        && data.get('closedAt', null) == null
        && (!isUpdate || (resource.data.status == 'OPEN'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'voteId', 'requestId', 'openedByUid', 'openedAt', 'eligibleVoterCount', 'yesVoteCount', 'status', 'closedAt'
          ])
          && resource.data.openedAt is timestamp
          && request.time >= resource.data.openedAt + duration.value(30, 's')
          && data.voteId != resource.data.voteId));
    }

    function validTerminationBallot(roomId, uid) {
      let data = request.resource.data;
      let voteBefore = get(terminationVotePath(roomId)).data;
      let voteAfter = getAfter(terminationVotePath(roomId)).data;
      let room = get(roomPath(roomId)).data;
      let member = get(hostMemberPath(roomId, uid)).data;
      return signedIn()
        && uid == request.auth.uid
        && room.status == 'ACTIVE'
        && member.status == 'ACTIVE'
        && data.keys().hasAll(['version', 'voteId', 'requestId', 'choice', 'castAt'])
        && data.keys().hasOnly(['version', 'voteId', 'requestId', 'choice', 'castAt'])
        && data.version == 1
        && data.voteId == voteBefore.voteId
        && data.requestId is string
        && data.requestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && data.choice in ['YES', 'NO']
        && data.castAt == request.time
        && voteBefore.status == 'OPEN'
        && voteBefore.openedAt is timestamp
        && request.time < voteBefore.openedAt + duration.value(30, 's')
        && (!exists(terminationBallotPath(roomId, uid))
          || get(terminationBallotPath(roomId, uid)).data.voteId != voteBefore.voteId)
        && voteAfter.yesVoteCount == voteBefore.yesVoteCount + (data.choice == 'YES' ? 1 : 0)
        && voteAfter.eligibleVoterCount == voteBefore.eligibleVoterCount
        && voteAfter.status == (voteAfter.yesVoteCount == voteAfter.eligibleVoterCount ? 'CANCELLED' : 'OPEN')
        && (voteAfter.status == 'OPEN' || voteAfter.closedAt == request.time);
    }

    // Marker cũ không đủ: phải có lần duyệt rời mới trong chính giao dịch này.
    function hasNewApprovedVoteExit(roomId) {
      let roomBefore = get(roomPath(roomId)).data;
      let roomAfter = getAfter(roomPath(roomId)).data;
      let uid = roomAfter.lastEarlyExitMemberUid;
      let memberBefore = get(hostMemberPath(roomId, uid)).data;
      let memberAfter = getAfter(hostMemberPath(roomId, uid)).data;
      let exitBefore = get(earlyExitRequestPath(roomId, uid)).data;
      let exitAfter = getAfter(earlyExitRequestPath(roomId, uid)).data;
      return roomBefore.hostId == request.auth.uid
        && roomAfter.activeMemberCount == roomBefore.activeMemberCount - 1
        && roomAfter.activeMemberCount > 0
        && roomAfter.updatedAt == request.time
        && memberBefore.status == 'ACTIVE'
        && memberAfter.status == 'EARLY_EXIT'
        && memberAfter.earlyExitAt == request.time
        && exitBefore.status == 'OPEN'
        && exitAfter.status == 'APPROVED'
        && exitAfter.requestId == exitBefore.requestId
        && exitAfter.requestId == roomAfter.lastEarlyExitRequestId
        && exitAfter.decision == 'APPROVE'
        && exitAfter.decidedBy == request.auth.uid
        && exitAfter.cutoffAt == request.time;
    }

    function validTerminationVoteUpdate(roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let room = get(roomPath(roomId)).data;
      let member = get(hostMemberPath(roomId, request.auth.uid)).data;
      let callerBallotPath = terminationBallotPath(roomId, request.auth.uid);
      let hasNewBallot = existsAfter(callerBallotPath)
        && getAfter(callerBallotPath).data.voteId == before.voteId
        && (!exists(callerBallotPath) || get(callerBallotPath).data.voteId != before.voteId);
      let callerBallot = existsAfter(callerBallotPath) ? getAfter(callerBallotPath).data : {};
      let exitUid = getAfter(roomPath(roomId)).data.get('lastEarlyExitMemberUid', request.auth.uid);
      let exitBallotPath = terminationBallotPath(roomId, exitUid);
      let removedYes = exitUid is string && exists(exitBallotPath)
        && get(exitBallotPath).data.voteId == before.voteId && get(exitBallotPath).data.choice == 'YES';
      return signedIn()
        && room.status == 'ACTIVE'
        && member.status == 'ACTIVE'
        && before.status == 'OPEN'
        && before.openedAt is timestamp
        && request.time < before.openedAt + duration.value(30, 's')
        && after.voteId == before.voteId
        && after.openedAt == before.openedAt
        && after.eligibleVoterCount is int && after.eligibleVoterCount > 0
        && after.yesVoteCount is int && after.yesVoteCount >= 0
        && after.yesVoteCount <= after.eligibleVoterCount
        && (after.status != 'CANCELLED'
          || (getAfter(roomPath(roomId)).data.status == 'CANCELLED'
            && getAfter(roomPath(roomId)).data.endedAt == request.time))
        && after.diff(before).affectedKeys().hasOnly(['yesVoteCount', 'eligibleVoterCount', 'status', 'closedAt'])
        && ((hasNewBallot
          && after.eligibleVoterCount == before.eligibleVoterCount
          && after.yesVoteCount == before.yesVoteCount + (callerBallot.choice == 'YES' ? 1 : 0)
          && after.status == (after.yesVoteCount == after.eligibleVoterCount ? 'CANCELLED' : 'OPEN')
          && (after.status == 'OPEN' || after.closedAt == request.time))
          || (hasNewApprovedVoteExit(roomId)
            && before.eligibleVoterCount == room.activeMemberCount
            && after.eligibleVoterCount == getAfter(roomPath(roomId)).data.activeMemberCount
            && after.eligibleVoterCount == before.eligibleVoterCount - 1
            && after.yesVoteCount == before.yesVoteCount - (removedYes ? 1 : 0)
            && after.status == (after.yesVoteCount == after.eligibleVoterCount ? 'CANCELLED' : 'OPEN')
            && after.get('closedAt', null) == (after.status == 'CANCELLED' ? request.time : before.get('closedAt', null))));
    }

    function validEarlyExitRoomUpdate(roomId) {
      let after = request.resource.data;
      let memberUid = after.lastEarlyExitMemberUid;
      let requestPath = earlyExitRequestPath(roomId, memberUid);
      let exitRequest = getAfter(requestPath).data;
      let votePath = terminationVotePath(roomId);
      let voteBefore = get(votePath).data;
      let voteAfter = getAfter(votePath).data;
      let ballotPath = terminationBallotPath(roomId, memberUid);
      let currentVote = exists(votePath) && voteBefore.status == 'OPEN'
        && voteBefore.openedAt is timestamp
        && request.time < voteBefore.openedAt + duration.value(30, 's');
      let removeYes = exists(ballotPath) && get(ballotPath).data.voteId == voteBefore.voteId
        && get(ballotPath).data.choice == 'YES';
      return signedIn()
        && resource.data.status == 'ACTIVE'
        && after.diff(resource.data).affectedKeys().hasOnly([
          'activeMemberCount', 'updatedAt', 'lastEarlyExitMemberUid', 'lastEarlyExitRequestId', 'status', 'endedAt'
        ])
        && resource.data.activeMemberCount is int
        && after.activeMemberCount == resource.data.activeMemberCount - 1
        && after.updatedAt == request.time
        && memberUid is string
        && get(hostMemberPath(roomId, memberUid)).data.status == 'ACTIVE'
        && getAfter(hostMemberPath(roomId, memberUid)).data.status == 'EARLY_EXIT'
        && getAfter(hostMemberPath(roomId, memberUid)).data.earlyExitAt == request.time
        && exitRequest.status == 'APPROVED'
        && exitRequest.requestId == after.lastEarlyExitRequestId
        && exitRequest.decision == 'APPROVE'
        && exitRequest.decidedBy == request.auth.uid
        && exitRequest.cutoffAt == request.time
        && get(roomPath(roomId)).data.hostId == request.auth.uid
        && get(hostMemberPath(roomId, request.auth.uid)).data.role == 'HOST'
        && get(hostMemberPath(roomId, request.auth.uid)).data.status == 'ACTIVE'
        && (currentVote
          ? (voteAfter.eligibleVoterCount == voteBefore.eligibleVoterCount - 1
            && voteAfter.yesVoteCount == voteBefore.yesVoteCount - (removeYes ? 1 : 0))
          : (!exists(votePath) || voteAfter.diff(voteBefore).affectedKeys().size() == 0))
        && (after.status == 'CANCELLED'
          ? (currentVote && voteAfter.status == 'CANCELLED'
            && voteAfter.yesVoteCount == voteAfter.eligibleVoterCount && after.endedAt == request.time)
          : (after.status == 'ACTIVE' && after.endedAt == resource.data.endedAt
            && (!currentVote || voteAfter.status == 'OPEN')));
    }

    function validEarlyExitMemberApproval(roomId, memberUid) {
      let requestPath = earlyExitRequestPath(roomId, memberUid);
      let earlyExitRequest = getAfter(requestPath).data;
      return signedIn()
        && memberUid == earlyExitRequest.memberUid
        && resource.data.status == 'ACTIVE'
        && resource.data.earlyExitAt == null
        && request.resource.data.status == 'EARLY_EXIT'
        && request.resource.data.earlyExitAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'earlyExitAt'])
        && earlyExitRequest.status == 'APPROVED'
        && earlyExitRequest.decision == 'APPROVE'
        && earlyExitRequest.decidedBy == request.auth.uid
        && earlyExitRequest.decidedAt == request.time
        && earlyExitRequest.cutoffAt == request.time
        && get(requestPath).data.status == 'OPEN'
        && get(roomPath(roomId)).data.status == 'ACTIVE'
        && get(roomPath(roomId)).data.hostId == request.auth.uid;
    }

    function validGroupViolation(roomId, eventId, data) {
      let room = get(roomPath(roomId)).data;
      let member = get(hostMemberPath(roomId, request.auth.uid)).data;
      let memberAfter = getAfter(hostMemberPath(roomId, request.auth.uid)).data;
      return data.keys().hasAll(['eventId', 'actorUid', 'startedAt', 'endedAt', 'durationSeconds', 'createdAt'])
        && data.keys().hasOnly(['eventId', 'actorUid', 'startedAt', 'endedAt', 'durationSeconds', 'createdAt'])
        && eventId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && data.eventId == eventId
        && data.actorUid == request.auth.uid
        && data.startedAt is timestamp
        && data.endedAt is timestamp
        && (member.status == 'ACTIVE' || (member.status == 'EARLY_EXIT'
          && member.earlyExitAt is timestamp && data.endedAt <= member.earlyExitAt))
        && data.startedAt >= room.startedAt
        && data.endedAt >= data.startedAt
        && data.endedAt <= request.time
        && data.durationSeconds is int
        && data.durationSeconds >= 3
        && data.endedAt >= data.startedAt + duration.value(data.durationSeconds, 's')
        && data.endedAt < data.startedAt + duration.value(data.durationSeconds + 1, 's')
        && data.createdAt == request.time
        && memberAfter.get('lastViolationEventId', null) == eventId;
    }

    // Sau override, event hợp lệ chỉ vào history; member score và snapshot đã khóa.
    function validExcludedGroupViolation(roomId, eventId, data) {
      let room = get(roomPath(roomId)).data;
      let member = get(hostMemberPath(roomId, request.auth.uid)).data;
      return room.status == 'COMPLETED'
        && room.reconciliationStatus == 'FINALIZED'
        && room.finalizationReason == 'HOST_OVERRIDE'
        && member.status in ['ACTIVE', 'EARLY_EXIT']
        && data.keys().hasAll([
          'eventId', 'actorUid', 'startedAt', 'endedAt', 'durationSeconds', 'createdAt',
          'excludedFromFinalScore', 'exclusionReason'
        ])
        && data.keys().hasOnly([
          'eventId', 'actorUid', 'startedAt', 'endedAt', 'durationSeconds', 'createdAt',
          'excludedFromFinalScore', 'exclusionReason'
        ])
        && eventId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && data.eventId == eventId
        && data.actorUid == request.auth.uid
        && data.startedAt is timestamp
        && data.endedAt is timestamp
        && data.startedAt >= room.startedAt
        && data.endedAt >= data.startedAt
        && data.endedAt <= room.endedAt
        && data.endedAt <= request.time
        && (member.status != 'EARLY_EXIT'
          || (member.earlyExitAt is timestamp && data.endedAt <= member.earlyExitAt))
        && data.durationSeconds is int
        && data.durationSeconds >= 3
        && data.endedAt >= data.startedAt + duration.value(data.durationSeconds, 's')
        && data.endedAt < data.startedAt + duration.value(data.durationSeconds + 1, 's')
        && data.createdAt == request.time
        && data.excludedFromFinalScore == true
        && data.exclusionReason == 'HOST_OVERRIDE';
    }

    function validGroupViolationMemberUpdate(roomId, memberUid) {
      let after = request.resource.data;
      let eventId = after.get('lastViolationEventId', null);
      let eventPath = /databases/$(database)/documents/rooms/$(roomId)/violations/$(eventId);
      let event = getAfter(eventPath).data;
      let eventDuration = event.durationSeconds;
      return memberUid == request.auth.uid
        && canRecordGroupViolation(roomId, memberUid, event.endedAt)
        && eventId is string
        // Chỉ cho phép tăng điểm khi cùng transaction tạo event mới, không khi trỏ lại event cũ.
        && !exists(eventPath)
        && resource.data.get('lastViolationEventId', null) != eventId
        && after.diff(resource.data).affectedKeys().hasOnly(['liftCount', 'violationDurationSeconds', 'penaltyScore', 'lastViolationEventId'])
        && after.lastViolationEventId == eventId
        && event.actorUid == memberUid
        && event.eventId == eventId
        && resource.data.liftCount is int
        && resource.data.violationDurationSeconds is int
        && resource.data.penaltyScore is int
        && after.liftCount is int
        && after.violationDurationSeconds is int
        && after.penaltyScore is int
        && after.liftCount == resource.data.liftCount + 1
        && after.violationDurationSeconds == resource.data.violationDurationSeconds + eventDuration
        && after.penaltyScore == resource.data.penaltyScore + 10 + eventDuration
        && after.penaltyScore == after.liftCount * 10 + after.violationDurationSeconds;
    }

    function validUsageCreate(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['bucketStart', 'count', 'lastRequestId', 'updatedAt'])
        && data.keys().hasOnly(['bucketStart', 'count', 'lastRequestId', 'updatedAt'])
        && data.bucketStart == currentQuotaBucketStart()
        && data.count == 1
        && data.updatedAt == request.time
        && data.lastRequestId is string
        && data.lastRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && hasRoomCreateLinks(
          getAfter(receiptPath(uid, data.lastRequestId)).data.roomId,
          uid,
          getAfter(receiptPath(uid, data.lastRequestId)).data.pin,
          data.lastRequestId
        );
    }

    function validUsageUpdate(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let sameMonth = before.bucketStart == currentQuotaBucketStart();
      let expectedCount = sameMonth ? before.count + 1 : 1;
      return after.keys().hasAll(['bucketStart', 'count', 'lastRequestId', 'updatedAt'])
        && after.keys().hasOnly(['bucketStart', 'count', 'lastRequestId', 'updatedAt'])
        && after.bucketStart == currentQuotaBucketStart()
        && after.updatedAt == request.time
        && after.lastRequestId is string
        && after.lastRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && after.count == expectedCount
        && (isServerPremium(uid) || after.count <= 7)
        && hasRoomCreateLinks(
          getAfter(receiptPath(uid, after.lastRequestId)).data.roomId,
          uid,
          getAfter(receiptPath(uid, after.lastRequestId)).data.pin,
          after.lastRequestId
        );
    }

    match /users/{uid} {
      // Hồ sơ chỉ được tạo một lần; client không thể tự cấp Premium hay sửa hồ sơ người khác.
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['displayName', 'email', 'isPremium', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'isPremium', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && !request.resource.data.displayName.matches('^\\s*$')
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isPremium == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow list, update, delete: if false;

      // Solo summary được ghi bởi syncEvents; owner chỉ đọc history của chính mình.
      match /sessions/{sessionId} {
        allow get, list: if request.auth != null && request.auth.uid == uid;
        allow create, update, delete: if false;
      }

      // Server-time probe chỉ trả giờ Rules; nó không thay đổi quota hoặc room state.
      match /roomQuotaClock/current {
        allow get: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['checkedAt'])
          && request.resource.data.keys().hasOnly(['checkedAt'])
          && request.resource.data.checkedAt == request.time;
        allow list, delete: if false;
      }

      // Counter chỉ đổi trong giao dịch tạo room được liên kết đầy đủ.
      match /usage/current {
        allow get: if isOwner(uid);
        allow create: if isOwner(uid) && validUsageCreate(uid);
        allow update: if isOwner(uid) && validUsageUpdate(uid);
        allow list, delete: if false;
      }

      // Receipt chỉ được tạo cùng room transaction; không thể sửa outcome sau commit.
      match /commandReceipts/{requestId} {
        allow get: if isOwner(uid);
        allow create: if isOwner(uid)
          && requestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
          && request.resource.data.keys().hasAll(['version', 'requestId', 'roomId', 'pin', 'hostId', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['version', 'requestId', 'roomId', 'pin', 'hostId', 'status', 'createdAt'])
          && request.resource.data.version == 1
          && request.resource.data.requestId == requestId
          && request.resource.data.status == 'WAITING'
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.hostId == uid && hasRoomCreateLinks(
                request.resource.data.roomId,
                uid,
                request.resource.data.pin,
                requestId
              )) || validJoinReceipt(uid, request.resource.data, requestId));
        allow list, update, delete: if false;
      }
    }

    // Ngoại lệ Spark chỉ mở các room transaction cụ thể đã được ADR phê duyệt.
    match /rooms/{roomId} {
      allow get: if canReadRoom(roomId);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'hostId', 'pin', 'status', 'participantCount', 'createdAt', 'updatedAt',
          'hostHeartbeatAt', 'startedAt', 'endedAt', 'lastJoinRequestId'
        ])
        && request.resource.data.keys().hasOnly([
          'hostId', 'pin', 'status', 'participantCount', 'createdAt', 'updatedAt',
          'hostHeartbeatAt', 'startedAt', 'endedAt', 'lastJoinRequestId', 'lastStartRequestId',
          'lastEarlyExitMemberUid', 'lastEarlyExitRequestId'
        ])
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{8}$')
        && roomId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
        && request.resource.data.status == 'WAITING'
        && request.resource.data.participantCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.hostHeartbeatAt == request.time
        && request.resource.data.startedAt == null
        && request.resource.data.endedAt == null
        && request.resource.data.lastJoinRequestId == null
        && request.resource.data.get('lastEarlyExitMemberUid', null) == null
        && request.resource.data.get('lastEarlyExitRequestId', null) == null
        // Marker mới là tùy chọn để các bản app cũ vẫn tạo được phòng trong thời gian rollout.
        && request.resource.data.get('lastStartRequestId', null) == null
        && hasRoomCreateLinks(
          roomId,
          request.auth.uid,
          request.resource.data.pin,
          getAfter(usagePath(request.auth.uid)).data.lastRequestId
        );
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'updatedAt', 'lastJoinRequestId'])
          && request.resource.data.participantCount is int
          && request.resource.data.updatedAt == request.time
          && request.resource.data.status == 'WAITING'
          && request.resource.data.lastJoinRequestId is string
          && request.resource.data.lastJoinRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
          && hasRoomJoinLinks(roomId, request.auth.uid, resource.data.pin, request.resource.data.lastJoinRequestId)
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'updatedAt', 'lastStartRequestId', 'activeMemberCount', 'hostHeartbeatAt'])
          && request.resource.data.hostId == request.auth.uid
          && resource.data.status == 'WAITING'
          && resource.data.startedAt == null
          // Room từ bản cũ chưa có marker được xem như chưa bắt đầu.
          && resource.data.get('lastStartRequestId', null) == null
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.startedAt == request.time
          && request.resource.data.updatedAt == request.time
          // Client mới làm mới liveness khi start; bản cũ vẫn được start và dùng startedAt làm mốc.
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostHeartbeatAt'])
            || request.resource.data.hostHeartbeatAt == request.time)
          // App cũ vẫn start được; chỉ build mới khởi tạo voter count cho SL-019.
          && (request.resource.data.get('activeMemberCount', null) == null
            || request.resource.data.activeMemberCount == resource.data.participantCount)
          && request.resource.data.lastStartRequestId is string
          && request.resource.data.lastStartRequestId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$')
          && exists(hostMemberPath(roomId, request.auth.uid))
          && get(hostMemberPath(roomId, request.auth.uid)).data.role == 'HOST'
          && get(hostMemberPath(roomId, request.auth.uid)).data.status == 'ACTIVE'
        ) || (
          request.resource.data.status == 'CANCELLED'
          && request.resource.data.endedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt', 'updatedAt'])
          && resource.data.status == 'ACTIVE'
          && get(terminationVotePath(roomId)).data.status == 'OPEN'
          && get(terminationVotePath(roomId)).data.openedAt is timestamp
          && request.time < get(terminationVotePath(roomId)).data.openedAt + duration.value(30, 's')
          && getAfter(terminationVotePath(roomId)).data.status == 'CANCELLED'
          && getAfter(terminationVotePath(roomId)).data.closedAt == request.time
          && getAfter(terminationVotePath(roomId)).data.yesVoteCount == getAfter(terminationVotePath(roomId)).data.eligibleVoterCount
          && getAfter(terminationVotePath(roomId)).data.eligibleVoterCount > 0
          && existsAfter(terminationBallotPath(roomId, request.auth.uid))
          && getAfter(terminationBallotPath(roomId, request.auth.uid)).data.voteId == get(terminationVotePath(roomId)).data.voteId
          && getAfter(terminationBallotPath(roomId, request.auth.uid)).data.choice == 'YES'
          && (!exists(terminationBallotPath(roomId, request.auth.uid))
            || get(terminationBallotPath(roomId, request.auth.uid)).data.voteId != get(terminationVotePath(roomId)).data.voteId)
        ) || validHostHeartbeat(roomId)
        || validStaleRoomAbort(roomId)
        || validEarlyExitRoomUpdate(roomId)
        || validRoomCompletion(roomId)
        || validRoomSyncAcknowledgment(roomId)
        || validHostScoreOverride(roomId)
        || validBillPublishRoom(roomId)
      );
      allow list, delete: if false;

      match /members/{memberUid} {
        allow get: if signedIn() && (
          memberUid == request.auth.uid || exists(hostMemberPath(roomId, request.auth.uid))
        );
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.keys().hasAll([
            'displayName', 'role', 'status', 'penaltyScore', 'liftCount',
          'violationDurationSeconds', 'joinedAt', 'earlyExitAt', 'syncedThroughAt', 'syncAcknowledgedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'displayName', 'role', 'status', 'penaltyScore', 'liftCount',
          'violationDurationSeconds', 'joinedAt', 'earlyExitAt', 'syncedThroughAt', 'syncAcknowledgedAt', 'lastViolationEventId', 'syncAckRequestId'
          ])
          && request.resource.data.displayName == get(profilePath(memberUid)).data.displayName
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.penaltyScore == 0
          && request.resource.data.liftCount == 0
          && request.resource.data.violationDurationSeconds == 0
          && request.resource.data.joinedAt == request.time
          && request.resource.data.earlyExitAt == null
          && request.resource.data.syncedThroughAt == null
          && request.resource.data.syncAcknowledgedAt == null
        && request.resource.data.get('syncAckRequestId', null) == null
          && request.resource.data.get('lastViolationEventId', null) == null
          && (
            (request.resource.data.role == 'HOST' && hasRoomCreateLinks(
              roomId, memberUid, getAfter(roomPath(roomId)).data.pin,
              getAfter(usagePath(memberUid)).data.lastRequestId
            ))
            || (request.resource.data.role == 'MEMBER' && hasRoomJoinLinks(
              roomId, memberUid, getAfter(roomPath(roomId)).data.pin,
              getAfter(roomPath(roomId)).data.lastJoinRequestId
            ))
          );
        allow list: if roomParticipant(roomId, request.auth.uid);
        allow update: if signedIn() && (
          validGroupViolationMemberUpdate(roomId, memberUid)
          || validMemberSyncAcknowledgment(roomId, memberUid)
          || validEarlyExitMemberApproval(roomId, memberUid)
        );
        allow delete: if false;
      }

      match /earlyExitRequests/{memberUid} {
        // Host cần đọc lại một quyết định đã lưu để retry idempotent sau khi room kết thúc.
        allow get: if roomParticipant(roomId, request.auth.uid) || terminalRoomHost(roomId, request.auth.uid);
        allow list: if roomParticipant(roomId, request.auth.uid);
        allow create: if validEarlyExitRequest(roomId, memberUid, request.resource.data, false);
        allow update: if validEarlyExitRequest(roomId, memberUid, request.resource.data, true)
          || validEarlyExitDecision(roomId, memberUid);
        allow delete: if false;
      }

      match /reconciliationAudits/{auditId} {
        allow get, list: if roomParticipant(roomId, request.auth.uid);
        allow create: if validHostOverrideAuditCreate(roomId, auditId);
        allow update, delete: if false;
      }

      match /settlementDetails/{detailId} {
        allow get: if detailId == 'current' && roomParticipant(roomId, request.auth.uid)
          && (!exists(settlementDetailsPath(roomId))
            || (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time));
        allow list: if false;
        allow create, update: if detailId == 'current' && validSettlementDetails(roomId);
        allow delete: if false;
      }

      match /billCommands/{requestId} {
        allow get: if roomParticipant(roomId, request.auth.uid);
        allow list: if false;
        allow create: if validBillCommandCreate(roomId, requestId);
        allow update, delete: if false;
      }

      match /billShares/{uid} {
        allow get, list: if roomParticipant(roomId, request.auth.uid)
          && get(roomPath(roomId)).data.calculationVersion == 1
          && get(roomPath(roomId)).data.reconciliationStatus == 'FINALIZED'
          && exists(settlementDetailsPath(roomId))
          && get(settlementDetailsPath(roomId)).data.expiresAt is timestamp
          && get(settlementDetailsPath(roomId)).data.expiresAt > request.time;
        allow create: if validBillShareCreate(roomId, uid);
        allow update, delete: if false;
      }

      match /terminationVotes/{voteId} {
        allow get, list: if roomParticipant(roomId, request.auth.uid);
        allow create: if voteId == 'current' && validOpenTerminationVote(roomId, false);
        allow update: if voteId == 'current'
          && (validOpenTerminationVote(roomId, true) || validTerminationVoteUpdate(roomId));
        allow delete: if false;

        match /ballots/{uid} {
          allow get, list: if roomParticipant(roomId, request.auth.uid);
          allow create, update: if voteId == 'current' && validTerminationBallot(roomId, uid);
          allow delete: if false;
        }
      }

      match /violations/{eventId} {
        // Thành viên còn trong roster đọc event khi ACTIVE hoặc COMPLETED để retry/replay reconciliation.
        allow get, list: if canReadGroupViolations(roomId, request.auth.uid);
        allow create: if signedIn()
          && ((canRecordGroupViolation(roomId, request.auth.uid, request.resource.data.endedAt)
              && validGroupViolation(roomId, eventId, request.resource.data))
            || validExcludedGroupViolation(roomId, eventId, request.resource.data));
        allow update, delete: if false;
      }
    }

    // Exact get tra PIN được phép cho user đăng nhập; collection listing vẫn bị chặn.
    match /roomPins/{pin} {
      allow create: if signedIn()
        && pin.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasAll(['roomId', 'hostId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['roomId', 'hostId', 'createdAt'])
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && hasRoomCreateLinks(
          request.resource.data.roomId,
          request.auth.uid,
          pin,
          getAfter(usagePath(request.auth.uid)).data.lastRequestId
        );
      allow get: if signedIn() && pin.matches('^(?:[0-9]{4}|[0-9]{8})$');
      allow list, update, delete: if false;
    }

    // Các document khác vẫn deny-by-default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
