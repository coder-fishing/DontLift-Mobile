# Copy these public Firebase Web settings from the mobile project's local config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin runs against the same Firebase Cloud project as mobile.
FIREBASE_RUNTIME_MODE=cloud
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_RUNTIME_MODE=cloud

# Trusted CLI execution uses Application Default Credentials.
ADMIN_OPERATOR_MODE=cloud
ADMIN_OPERATOR_PROJECT_ID=
ADMIN_OPERATOR_ID=local-operator
